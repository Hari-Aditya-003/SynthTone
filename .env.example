# SynthTone Environment Configuration (Dell GPU Linux Server)
# Generate a secure 32+ character random secret:
# python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
SYNTHTONE_API_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Target execution device: 'auto' (detects NVIDIA CUDA GPU), 'cuda', or 'cpu'
SYNTHTONE_DEVICE=auto

# Optional Hugging Face Token to avoid anonymous download rate limits
HF_TOKEN=
